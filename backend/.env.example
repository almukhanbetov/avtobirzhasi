POSTGRES_DB=avtobirzhsi_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5435

DATABASE_URL=postgres://postgres:changeme@localhost:5435/avtobirzhsi_db?sslmode=disable
JWT_SECRET=change-me-in-local-env
PORT=8080

# Seller-uploaded listing photos (see
# backend/internal/handlers/uploads.go). Files are written under
# UPLOAD_DIR and served from PUBLIC_UPLOAD_BASE_URL/uploads/<name>.
# Defaults below are the local-dev values, so this section is optional
# for local work.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:8080

# FreedomPay (real deposit payment provider — see
# backend/internal/service/payment_freedompay.go). Leave both
# FREEDOMPAY_MERCHANT_ID and FREEDOMPAY_SECRET_KEY empty to keep using
# MockPaymentProvider (no real money moves) — this is the default and
# safe for local development.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
FREEDOMPAY_TESTING_MODE=1
FREEDOMPAY_RESULT_URL=http://localhost:8080/api/webhooks/payments/freedompay
FREEDOMPAY_SUCCESS_URL=http://localhost:3000/dashboard/deposits/return
FREEDOMPAY_FAILURE_URL=http://localhost:3000/dashboard/deposits/return
# Leave empty to use FreedomPay's production API host; only override for
# a sandbox host if FreedomPay gives you a separate one.
FREEDOMPAY_BASE_URL=
