# This is a SNIPPET to merge into the VPS's real /etc/caddy/Caddyfile —
# it is intentionally NOT named plain "Caddyfile" so nobody mistakes it
# for the whole server config and overwrites what's already there.
#
# Before touching anything on the VPS: run `cat /etc/caddy/Caddyfile`
# (or wherever Caddy's config actually lives there) and paste it back so
# these two blocks can be merged in without disturbing any other site
# already being served from that same Caddy instance.
#
# DNS (not done automatically — add this yourself, then wait for it to
# propagate before Caddy can issue a certificate for it):
#   A record   api.avtobirzhasi.kz   ->   37.140.243.250

avtobirzhasi.kz, www.avtobirzhasi.kz {
	reverse_proxy 127.0.0.1:3000
}

api.avtobirzhasi.kz {
	# Defense-in-depth, not the only guard: backend/internal/middleware/
	# localonly.go's LocalOnly() independently rejects any request whose
	# TCP peer isn't 127.0.0.1/::1, and Stage 8C (2026-08-26) directly
	# confirmed on production that /internal/* correctly returns 401/403
	# for unauthorized callers regardless of this block's own live-merge
	# state — see STAGE8B_REAL_PRODUCTION_VERIFICATION_REPORT.md's Stage
	# 8C section. This block should still stay in place (stopping the
	# request at the edge is strictly better than relying on the backend
	# alone), but its absence would not, by itself, expose
	# moderation/admin-stats/daily-tick to the public internet — don't
	# treat this Caddy rule as the sole safeguard when reasoning about
	# this path's security.
	handle /internal/* {
		respond 404
	}

	reverse_proxy 127.0.0.1:8080
}
