# This is a SNIPPET to merge into the VPS's real /etc/caddy/Caddyfile —
# it is intentionally NOT named plain "Caddyfile" so nobody mistakes it
# for the whole server config and overwrites what's already there.
#
# Before touching anything on the VPS: run `cat /etc/caddy/Caddyfile`
# (or wherever Caddy's config actually lives there) and paste it back so
# these two blocks can be merged in without disturbing any other site
# already being served from that same Caddy instance.
#
# DNS (not done automatically — add this yourself, then wait for it to
# propagate before Caddy can issue a certificate for it):
#   A record   api.avtobirzhasi.kz   ->   37.140.243.250

avtobirzhasi.kz, www.avtobirzhasi.kz {
	reverse_proxy 127.0.0.1:3000
}

api.avtobirzhasi.kz {
	# Updated Stage 10 (2026-08-26): moderation and admin-stats moved OFF
	# /internal/* onto /api/admin/* (Auth + AdminOnly only, no network
	# check) — LocalOnly made them unreachable from any real admin browser
	# session, confirmed live against production before this stage. See
	# STAGE10_ADMIN_COMPLETION_REPORT.md. /internal/* now backs exactly one
	# thing: the manual daily-tick trigger, which must never be reachable
	# from the public internet by design. Defense-in-depth, not the only
	# guard: backend/internal/middleware/localonly.go's LocalOnly()
	# independently rejects any request whose TCP peer isn't 127.0.0.1/::1
	# regardless of this block's own live-merge state — but keep this rule
	# in place too; stopping the request at the edge is strictly better
	# than relying on the backend alone.
	handle /internal/* {
		respond 404
	}

	# /uploads/* (seller listing photos — see
	# backend/internal/handlers/uploads.go) is served by the backend
	# itself off a persistent Docker volume, so it needs no rule of its
	# own: the catch-all reverse_proxy below already forwards it to :8080.
	reverse_proxy 127.0.0.1:8080
}
