# Copy this file to backend.env on the VPS (next to docker-compose.prod.yml)
# and fill in real values. backend.env itself must NEVER be committed —
# see the root .gitignore.

# Point this at the existing Postgres on the VPS. If it's a native
# (non-Docker) install listening on the host, host.docker.internal is
# already wired up via docker-compose.prod.yml's extra_hosts. Adjust the
# port/db name/credentials to match what's actually there — do not create
# a new database for this.
DATABASE_URL=postgres://<user>:<password>@host.docker.internal:5432/<db>?sslmode=disable

# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=<generate-a-long-random-secret>

PORT=8080
