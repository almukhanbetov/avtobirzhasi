# Copy this file to backend.env on the VPS (next to docker-compose.prod.yml)
# and fill in real values. backend.env itself must NEVER be committed —
# see the root .gitignore.
#
# DATABASE_URL is NOT set here — docker-compose.prod.yml builds it from
# POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD in the root .env and injects
# it directly, so the same credentials aren't duplicated (and can't drift
# out of sync) across two files.

# Generate a long random value, e.g.: openssl rand -base64 48
JWT_SECRET=<generate-a-long-random-secret>

PORT=8080

# FreedomPay (real deposit payment provider) — see
# backend/internal/service/payment_freedompay.go and
# STAGE11_REAL_PAYMENT_REPORT.md's Production Enablement Requirements.
# Leaving FREEDOMPAY_MERCHANT_ID/FREEDOMPAY_SECRET_KEY empty is the safe
# default: the backend falls back to MockPaymentProvider and no real
# money moves. Only fill these in once FreedomPay has approved the
# merchant account AND this webhook URL is reachable over HTTPS.
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET_KEY=
# Set to 0 (or remove) once FreedomPay confirms production go-live —
# leaving this at 1 keeps every charge in FreedomPay's own test mode even
# with real production credentials configured.
FREEDOMPAY_TESTING_MODE=1
FREEDOMPAY_RESULT_URL=https://api.avtobirzhasi.kz/api/webhooks/payments/freedompay
FREEDOMPAY_SUCCESS_URL=https://avtobirzhasi.kz/dashboard/deposits/return
FREEDOMPAY_FAILURE_URL=https://avtobirzhasi.kz/dashboard/deposits/return
FREEDOMPAY_BASE_URL=
