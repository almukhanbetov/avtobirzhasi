# Copy to .env on the VPS, next to docker-compose.prod.yml. Docker Compose
# auto-loads this to substitute ${DOCKERHUB_USERNAME} in the image: lines —
# it's a different mechanism from backend.env/frontend.env (those are
# passed *into* the containers via env_file; this one is read by the
# `docker compose` CLI itself on the host, before containers even start).
DOCKERHUB_USERNAME=<your-dockerhub-username>
