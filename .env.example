# Copy to .env on the VPS, next to docker-compose.prod.yml. Docker Compose
# auto-loads this to substitute ${VAR} placeholders in docker-compose.prod.yml
# itself (image tags, the postgres service's environment, and backend's
# DATABASE_URL) — a different mechanism from backend.env/frontend.env
# (those are passed *into* the running containers via env_file; this one
# is read by the `docker compose` CLI on the host, before containers even
# start).
DOCKERHUB_USERNAME=<your-dockerhub-username>

# This project's own dedicated Postgres — do not reuse another project's
# database or credentials here. Pick a real password, not the placeholder.
POSTGRES_DB=avtobirzhasi
POSTGRES_USER=avtobirzhasi
POSTGRES_PASSWORD=<generate-a-real-password>
